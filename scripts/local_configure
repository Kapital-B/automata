#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ ! -f "${ROOT_DIR}/svc/local.env" ]; then
  cp "${ROOT_DIR}/svc/.env.example" "${ROOT_DIR}/svc/local.env"
  echo "Created svc/local.env"
else
  echo "Kept existing svc/local.env"
fi

if [ ! -f "${ROOT_DIR}/web/.env.local" ]; then
  cp "${ROOT_DIR}/web/.env.example" "${ROOT_DIR}/web/.env.local"
  echo "Created web/.env.local"
else
  echo "Kept existing web/.env.local"
fi

cat <<'EOF'
Next steps:
1. Edit svc/local.env with OAuth credentials, ENCRYPTION_KEY, and JWT_SECRET.
2. Run ./scripts/local_up
3. Run ./scripts/local_deploy
4. Set web/.env.local VITE_API_BASE_URL to the printed api_gateway_url
EOF

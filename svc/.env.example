# Copy to svc/local.env for Floci local deploys, or source for local debug.

LISTEN_ADDR=:8080
APP_PUBLIC_URL=http://localhost:4566

# Floci parity path uses Postgres. The local debug shortcut can override these.
DATABASE_ENGINE=postgres
DATABASE_URL=postgres://automata:automata@localhost:5432/automata?sslmode=disable

# Exactly 32 bytes (ASCII) for AES-256-GCM mailbox token encryption at rest.
ENCRYPTION_KEY=12345678901234567890123456789012

# JWT for app login (HS256); at least 32 bytes.
JWT_SECRET=abcdefghijklmnopqrstuvwxyz123456
AUTH_DEFAULT_USER_ID=a0000001-0000-4000-8000-000000000001

# Microsoft Entra app for mailbox connect + auth.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:4566/restapis/replace-after-deploy/local/_user_request_/api/accounts/callback
MS_AUTH_REDIRECT_URI=http://localhost:4566/restapis/replace-after-deploy/local/_user_request_/api/auth/microsoft/callback

# Optional Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4566/restapis/replace-after-deploy/local/_user_request_/api/auth/google/callback

# Slack connector. Fake mode remains valid locally.
SLACK_MODE=fake
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4566/restapis/replace-after-deploy/local/_user_request_/api/connectors/callback
SLACK_SUCCESS_PATH=/accounts?connector=slack

# AWS / Floci endpoints for DynamoDB, Lambda, API Gateway, and Bedrock stubs.
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
JOBS_TABLE=automata-jobs-local
JOB_CURSOR_SECRET=abcdefghijklmnopqrstuvwxyz123456
JOB_TERMINAL_RETENTION_DAYS=30
JOB_LEASE_SECONDS=960
JOB_PENDING_WAKE_AFTER_SECONDS=120
JOBS_INLINE=false

# Bedrock is the default LLM path for AWS/Floci.
BEDROCK_MODEL_ID=eu.amazon.nova-2-lite-v1:0
BEDROCK_RUNTIME_ENDPOINT=http://localhost:4566

# Optional OpenAI-compatible override for local experimentation.
# LLM_BASE_URL=http://localhost:1234
# LLM_MODEL=google/gemma-4-e4b
# LLM_API_KEY=

# Transitional Redis / Asynq settings remain for legacy flows only.
REDIS_ADDR=localhost:6379
ASYNQ_PREFIX=automata
JOB_QUEUE_SYNC_CONCURRENCY=2
JOB_QUEUE_CATEGORIZE_CONCURRENCY=1
JOB_QUEUE_SUMMARIZE_CONCURRENCY=1
JOB_QUEUE_DRAFT_CONCURRENCY=1
JOB_QUEUE_FORWARD_CONCURRENCY=1
GLOBAL_MAX_CONCURRENT_JOBS=2

# Web callbacks.
DASHBOARD_BASE_URL=http://localhost:5173
OAUTH_SUCCESS_PATH=/accounts/connected
OAUTH_ERROR_PATH=/accounts/error
AUTH_SUCCESS_PATH=/auth/callback
AUTH_ERROR_PATH=/auth/error

# Comma-separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

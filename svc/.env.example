# Copy to .env and export, or use `set -a && source .env`

LISTEN_ADDR=:8080
DATABASE_URL=file:./data.db?_foreign_keys=on

# Exactly 32 bytes (ASCII) for AES-256-GCM token encryption at rest
ENCRYPTION_KEY=12345678901234567890123456789012

# Microsoft Entra app (delegated; work + personal per spec §3.1)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Must match Entra redirect URI exactly (API host, not web/)
MS_REDIRECT_URI=http://localhost:8080/api/accounts/callback

# OAuth return targets (future web/ app)
DASHBOARD_BASE_URL=http://localhost:5173
OAUTH_SUCCESS_PATH=/accounts/connected
OAUTH_ERROR_PATH=/accounts/error

# Comma-separated; must include DASHBOARD_BASE_URL origin when using browser clients
CORS_ORIGINS=http://localhost:5173

# Optional
# OAUTH_STATE_TTL_SECONDS=900

# Copy to .env and export, or use `set -a && source .env`

LISTEN_ADDR=:8080
# Public URL of this API (used to default OAuth redirect URIs)
APP_PUBLIC_URL=http://localhost:8080

DATABASE_URL=file:./data.db?_foreign_keys=on

# Exactly 32 bytes (ASCII) for AES-256-GCM mailbox token encryption at rest
ENCRYPTION_KEY=12345678901234567890123456789012

# JWT for app login (HS256); at least 32 bytes
JWT_SECRET=abcdefghijklmnopqrstuvwxyz123456
# JWT_TTL_HOURS=24
# Refresh token lifetime (opaque, stored hashed); default 30 days
# REFRESH_TTL_DAYS=30

# When no Authorization: Bearer header is sent, API uses this user (seeded in migration 002)
AUTH_DEFAULT_USER_ID=a0000001-0000-4000-8000-000000000001

# Microsoft Entra app (delegated; work + personal per spec §3.1)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Mail connect callback (must match Entra)
MS_REDIRECT_URI=http://localhost:8080/api/accounts/callback
# Sign-in callback (add as separate redirect URI in Entra; defaults to APP_PUBLIC_URL + path)
# MS_AUTH_REDIRECT_URI=http://localhost:8080/api/auth/microsoft/callback

# Google OAuth (optional; Web client). Defaults GOOGLE_REDIRECT_URI to APP_PUBLIC_URL + /api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Local/OpenAI-compatible LLM for Phase 3 categorization
# Example for LM Studio OpenAI API:
LLM_BASE_URL=http://localhost:1234
LLM_MODEL=google/gemma-4-e4b
# LLM_API_KEY=

# Redis / Asynq background jobs
REDIS_ADDR=localhost:6379
ASYNQ_PREFIX=automata
JOB_QUEUE_SYNC_CONCURRENCY=2
JOB_QUEUE_CATEGORIZE_CONCURRENCY=1
JOB_QUEUE_SUMMARIZE_CONCURRENCY=1
JOB_QUEUE_DRAFT_CONCURRENCY=1
GLOBAL_MAX_CONCURRENT_JOBS=2

# OAuth return targets (web/ app). Mail connect uses OAUTH_*; app login uses AUTH_*
DASHBOARD_BASE_URL=http://localhost:5174
OAUTH_SUCCESS_PATH=/accounts/connected
OAUTH_ERROR_PATH=/accounts/error
AUTH_SUCCESS_PATH=/auth/callback
AUTH_ERROR_PATH=/auth/error

# Comma-separated
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Optional
# OAUTH_STATE_TTL_SECONDS=900
